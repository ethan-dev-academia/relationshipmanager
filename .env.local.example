# Copy this file to .env.local and fill in your Supabase project values.
# The app runs in a limited "demo mode" (no real auth/data persistence) until these are set.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Relationship start date (used for the "days together" counter & milestone countdowns).
# Format: YYYY-MM-DD
NEXT_PUBLIC_RELATIONSHIP_START=2026-03-07

# Display name of the app (PWA / add-to-home-screen title).
NEXT_PUBLIC_APP_NAME=Us
